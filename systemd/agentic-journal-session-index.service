[Unit]
Description=Agentic Journal session index: fold in the session digests machines sent (proj sessions)
After=agentic-journal.service

[Service]
Type=oneshot
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/agentic-journal
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node scripts/session-index.ts ingest
Nice=10
MemoryMax=512M
TimeoutStartSec=300
UMask=0077
