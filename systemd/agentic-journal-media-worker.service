[Unit]
Description=Agentic Journal IMDb media sync and explicitly requested updates
After=network-online.target agentic-journal.service
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/agentic-journal
Environment=NODE_ENV=production
EnvironmentFile=-/home/openclaw/projects/agentic-journal/.env
ExecStart=/usr/bin/env node scripts/media-worker.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=35
UMask=0077

[Install]
WantedBy=multi-user.target
