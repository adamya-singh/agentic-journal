[Unit]
Description=Agentic Journal development server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/agentic-journal
Environment=NODE_ENV=development
EnvironmentFile=-/home/openclaw/projects/agentic-journal/.env
ExecStart=/usr/bin/env npm run dev
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
