+def utc_now_iso() -> str:
+    """UTC now, written the way the Journal app writes it (JavaScript's toISOString).
+
+    `datetime.utcnow().isoformat()` has no zone, and JavaScript reads a zoneless
+    timestamp as local time, so the app showed CLI-stamped times hours off.
+    """
+    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
+
+
 def _lock_path(path: str) -> str:
     return f"{path}.lock"
 
 
+def _lock_holder_gone(lock_file: str, unsigned_grace_seconds: float) -> bool:
+    """True when the process that wrote this lock no longer exists.
+
+    A CLI run that is killed leaves its lock file behind; without this check
+    every later write to that file timed out until the lock was deleted by hand.
+    The Journal app takes the same lock (src/lib/cli-file-lock.ts) and writes its
+    pid the same way.
+    """
+    try:
+        with open(lock_file, "r", encoding="utf-8") as handle:
+            raw = handle.read().strip()
+        if not raw.isdigit() or int(raw) <= 0:
+            # Created but not signed yet, unless it has sat that way.
+            return time.time() - os.path.getmtime(lock_file) > unsigned_grace_seconds
+        os.kill(int(raw), 0)
+        return False
+    except ProcessLookupError:
+        return True
+    except PermissionError:
+        return False
+    except FileNotFoundError:
+        return False
+
+
 @contextmanager
 def file_locks(paths: Iterable[str], timeout_seconds: float = 5.0):
     ordered = sorted(set(paths))
